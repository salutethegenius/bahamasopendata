# Bahamas Open Data environment template
#
# Copy this file to `.env` at the repo root for Docker/local shared settings.
# The backend also looks for `backend/.env`, so you can either:
# 1. copy the relevant backend variables there, or
# 2. export them in your shell before starting the API.

# -----------------------------------------------------------------------------
# Backend / FastAPI
# -----------------------------------------------------------------------------

DATABASE_URL=postgresql://nationalpulse:nationalpulse@localhost:5432/nationalpulse
DEBUG=true
# Powers the public Ask/RAG response generation flow.
OPENAI_API_KEY=
# Powers Gemini normalization during ingestion.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Powers Pinecone embedding upserts and retrieval.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=national-pulse
PINECONE_ENVIRONMENT=us-east-1

# -----------------------------------------------------------------------------
# Admin auth / ingestion API
# -----------------------------------------------------------------------------
#
# The document upload endpoint is protected by admin auth.
# If the JWT key files below are missing, the API will generate them automatically
# on startup or first token issuance.

JWT_PRIVATE_KEY_PATH=backend/keys/jwt_ed25519_private.pem
JWT_PUBLIC_KEY_PATH=backend/keys/jwt_ed25519_public.pem
# Optional bootstrap admin. If both values are set, startup seeds the account
# when it does not already exist. Use a strong random password.
INITIAL_SUPERUSER_EMAIL=
INITIAL_SUPERUSER_PASSWORD=

# Set to false for local HTTP development, defaults to true in production.
COOKIE_SECURE=false
# Number of trusted reverse proxies in front of the app (0 = ignore X-Forwarded-For).
# Set to 1 if behind nginx/Cloudflare/etc.
TRUSTED_PROXY_COUNT=0

# -----------------------------------------------------------------------------
# Frontend / Next.js
# -----------------------------------------------------------------------------

# Keep this on the same host as the running FastAPI API to avoid local CORS mismatches.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# -----------------------------------------------------------------------------
# Docker Compose / Postgres
# -----------------------------------------------------------------------------

POSTGRES_USER=nationalpulse
POSTGRES_PASSWORD=nationalpulse
POSTGRES_DB=nationalpulse
